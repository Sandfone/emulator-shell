<Project Sdk="Microsoft.NET.Sdk">
  <!-- Installed by Emulator Shell as the SDK's emulator\emulator.exe; see EmulatorForwarder.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EmulatorShellForwarder</AssemblyName>
    <Product>Emulator Shell Forwarder</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <!-- One file, so it can stand in for emulator.exe among the SDK's own files. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
