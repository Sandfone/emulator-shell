<Project Sdk="Microsoft.NET.Sdk">
  <!-- The emulator's gRPC API, generated from the same protos as the macOS build. A library of its own because the
       WinUI project's XAML compiler builds its first pass without code that Grpc.Tools generates. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EmulatorShell.Protos</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
    <PackageReference Include="Grpc.Tools" Version="2.72.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="..\..\Sources\EmulatorShell\Protos\*.proto" ProtoRoot="..\..\Sources\EmulatorShell\Protos" GrpcServices="Client" />
  </ItemGroup>
</Project>
