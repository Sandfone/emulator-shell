<!--
  The Windows installer: a per-user MSI, so it needs no administrator. Installed per user (MSIINSTALLPERUSER), a
  dual-purpose package's program files folder is %LOCALAPPDATA%\Programs, where windows\build.ps1 installs too. Built by
  windows\package.ps1, which passes the version, the platform and the published app's folder.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Emulator Shell" Manufacturer="Emulator Shell" Version="$(Version)" Language="2052" Codepage="65001"
           UpgradeCode="8835d34f-bc62-4ba6-bf80-824756b56a99" Scope="perUserOrMachine" Compressed="yes">
    <SummaryInformation Description="Emulator Shell $(Version): Android 模拟器的设备窗口与管理器" />
    <!-- A newer version, or a rebuild of the same one, replaces what is installed; an older one is refused. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="已经安装了更新版本的 Emulator Shell。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(AppDir)\Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Emulator Shell" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(AppDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppShortcut" Name="Emulator Shell" Description="Android 模拟器的设备窗口与管理器"
                  Target="[INSTALLFOLDER]EmulatorShell.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU" Key="Software\EmulatorShell" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
