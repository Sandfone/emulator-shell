<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>EmulatorShell</RootNamespace>
    <AssemblyName>EmulatorShell</AssemblyName>
    <Product>Emulator Shell</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Runs as a plain exe, like the macOS build: no MSIX, and the Windows App SDK travels with it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Without it `dotnet publish` leaves out the app's .pri and compiled XAML (App.xbf), and the controls' styles. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Main is in Program.cs: it reads the command line before XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Protos\Protos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The SDK forwarder (windows\Forwarder) ships next to the app, which copies it into the SDK when asked. -->
  <Target Name="PublishForwarder" AfterTargets="Build">
    <MSBuild Projects="..\Forwarder\Forwarder.csproj" Targets="Restore" Properties="Configuration=$(Configuration);Platform=$(Platform)" RemoveProperties="TargetFramework;RuntimeIdentifier" />
    <MSBuild Projects="..\Forwarder\Forwarder.csproj" Targets="Publish" Properties="Configuration=$(Configuration);Platform=$(Platform);PublishDir=$(ProjectDir)$(OutDir)" RemoveProperties="TargetFramework;RuntimeIdentifier" />
  </Target>
</Project>
